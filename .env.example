POSTGRES_PASSWORD=postgres
SERVICE_DB_PASSWORD=localdev
KEYCLOAK_DB_PASSWORD=localdev
REPLICATION_PASSWORD=localdev

# Keycloak admin console (http://localhost:8180) login: admin / KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_ADMIN_PASSWORD=admin
# Secret of the auth-service client; must match "secret" in infra/keycloak/realms/payments-realm.json
KEYCLOAK_CLIENT_SECRET=local-auth-service-secret
